# ============================================================
# Supabase
# ============================================================

# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — bypasses Row Level Security.
# SERVER ONLY. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Postgres connection string — Transaction mode (port 6543) for serverless.
# Found in: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ============================================================
# Stripe
# ============================================================

# Found in: Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or from Stripe Dashboard → Developers → Webhooks → endpoint secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# App
# ============================================================

# Full public URL — used to build absolute redirect URLs (auth callbacks, Stripe success/cancel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of emails granted /admin access
# Example: admin@yourcompany.com,ops@yourcompany.com
ADMIN_EMAILS=
