# ============================================================
# Supabase  [REQUIRED]
# ============================================================

# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — bypasses Row Level Security.
# SERVER ONLY. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Postgres connection string — Transaction mode (port 6543) for serverless.
# Found in: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ============================================================
# Stripe  [REQUIRED]
# ============================================================

# Found in: Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or from Stripe Dashboard → Developers → Webhooks → endpoint secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# Cloudprinter  [REQUIRED for fulfillment — can be omitted in dev, stub adapter is used]
# ============================================================

# API key — from your Cloudprinter account dashboard
# SERVER ONLY. Never use NEXT_PUBLIC_ prefix.
CLOUDPRINTER_API_KEY=<cloudprinter-api-key>

# Base URL for the Cloudprinter API (production)
CLOUDPRINTER_API_URL=https://api.cloudprinter.com/cloudapps/1.0

# Webhook secret — used to verify incoming Cloudprinter status webhooks
# Set this in your Cloudprinter dashboard as the webhook endpoint secret
CLOUDPRINTER_WEBHOOK_SECRET=<cloudprinter-webhook-secret>

# ============================================================
# App
# ============================================================

# [OPTIONAL] Full public URL — defaults to http://localhost:3000 if unset
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [REQUIRED in production] Comma-separated list of emails granted /admin access.
# Must have at least one entry — the app will refuse to start in production if empty.
# Example: admin@yourcompany.com,ops@yourcompany.com
ADMIN_EMAILS=
